# Copy to .env and fill in. Read by the Python services (voice/, and backend/ + vision/ if they need it).
# The frontend has its own env file: frontend/.env.local (Next.js only reads env from its own folder).
OMNI_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_MODEL=qwen3.5-omni-flash
# Realtime relay (backend/, port 8001). Tina was verified in the Phase 0 live gate.
OMNI_REALTIME_MODEL=qwen3.5-omni-plus-realtime
OMNI_REALTIME_ENDPOINT=wss://yibuapi.com/v1/realtime
# Spoken voice for replies. Any of the 56 voices in the voice library: run the voice service and open
# http://localhost:8000/voices to browse and hear them (list: voice/voices.json).
OMNI_VOICE=Tina

# Backboard is used for durable cooking preferences and recipe context in Phase 4.
BACKBOARD_API_KEY=

# Set to 1 to make voice/ return a canned reply without calling Omni.
# VOICE_MOCK=1

# Recipe API (recipeapi.io) for the Explore page. Server-side only — never NEXT_PUBLIC_.
RECIPE_API_KEY=
# Password for the usage page (http://localhost:8000/usage). Leave empty to turn the page off.
USAGE_PAGE_PASSWORD=
# Other Omni call ledgers to include in the usage totals, separated by ; on Windows (: elsewhere).
# USAGE_EXTRA_LEDGERS=
