# Browser-visible URL only; do not put Omni or Backboard keys in this file.
NEXT_PUBLIC_LIVE_API_URL=http://localhost:8001
NEXT_PUBLIC_VOICE_API_URL=http://localhost:8000
# Sentry project DSN for browser errors, performance traces, and privacy-masked Session Replay.
NEXT_PUBLIC_SENTRY_DSN=
# Build-only Sentry release/source-map settings. Keep the auth token out of browser-visible variables.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
